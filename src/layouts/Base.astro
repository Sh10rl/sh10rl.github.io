---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Prefs from '../components/Prefs.astro';
import SearchDialog from '../components/SearchDialog.astro';
import favicon from '../assets/favicon.ico?url';
import sourceSerif from '../assets/fonts/source-serif-4-normal-latin.woff2?url';
import { site } from '../site.config';
import '../styles/fonts.css';
import '../styles/fonts-cjk.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  /** Article pages get reading tools: progress, current section, text size, footnote previews. */
  article?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, type = 'website', published, updated, article = false, jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/web-app-manifest-512x512.png', Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161311" media="(prefers-color-scheme: dark)" />
    <script is:inline define:vars={{ sourceSerif }}>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
          const size = localStorage.getItem('text-size');
          if (size === 's' || size === 'l' || size === 'xl') root.dataset.size = size;
          const font = localStorage.getItem('text-font');
          if (font === 'serif' || font === 'sans') root.dataset.font = font;
        } catch {}
        if (!root.dataset.font) {
          const preload = document.createElement('link');
          preload.rel = 'preload';
          preload.as = 'font';
          preload.type = 'font/woff2';
          preload.crossOrigin = 'anonymous';
          preload.href = sourceSerif;
          document.head.append(preload);
        }
        // The nav link a path belongs to, by the same rule Header.astro uses to mark the current one.
        const owns = (a, p) => {
          const h = new URL(a.href).pathname;
          return h === '/' ? p === '/' || /^\/(posts|categories|tags)\//.test(p) : p.startsWith(h);
        };
        let revealed = false;
        // pagereveal fires just before a page's first frame (also on Back and Forward), so anything
        // started here is in place from the very first frame.
        addEventListener('pagereveal', () => {
          const first = !revealed;
          revealed = true;

          // Where we came from. Without the Navigation API, a first load can still use the referrer.
          let path = '';
          try {
            const from = new URL(window.navigation ? window.navigation.activation?.from?.url : first ? document.referrer : '');
            if (from.origin === location.origin) path = from.pathname;
          } catch {}

          // The nav chip slides over from the section you came from, and the two labels trade colours
          // as it passes.
          const chip = document.querySelector('.nav-chip');
          const now = chip?.parentElement;
          const was = path && [...document.querySelectorAll('.nav a')].find((a) => owns(a, path));
          if (chip && was && was !== now && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const a = was.getBoundingClientRect();
            const b = now.getBoundingClientRect();
            const css = getComputedStyle(root);
            const time = css.getPropertyValue('--dur-snappy').trim();
            const duration = parseFloat(time) * (time.endsWith('ms') ? 1 : 1000);
            const timing = {
              duration: duration || 360,
              easing: css.getPropertyValue('--spring-snappy').trim() || 'ease-out',
            };
            chip.animate([{ left: `${a.left - b.left}px`, right: `${b.right - a.right}px` }, { left: '0px', right: '0px' }], timing);
            const on = getComputedStyle(now).color;
            const off = getComputedStyle(was).color;
            now.animate([{ color: off }, { color: on }], timing);
            was.animate([{ color: on }, { color: off }], timing);
          }
        });
      })();
    </script>
    <!-- Hold the first frame until the header is parsed, so pagereveal always finds the nav. -->
    <link rel="expect" href="#Main" blocking="render" />
    <link rel="icon" href={favicon} type="image/x-icon" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#Main">Skip to content</a>
    <Header article={article} />
    <main id="Main">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <Prefs article={article} />
    <div class="toast" role="status" aria-live="polite">
      <span class="toast-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5" pathLength="1"></path>
        </svg>
      </span>
      <span class="toast-text"></span>
    </div>
    {article && <div class="note-pop" popover="manual" role="tooltip" id="FootnotePreview" />}
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
