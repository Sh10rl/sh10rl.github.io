---
import Icon from './Icon.astro';
---

<dialog class="search glass" aria-label="Search posts" data-search>
  <form class="search-field" method="dialog" role="search">
    <Icon name="search" size={18} />
    <input
      type="search"
      name="q"
      placeholder="Search posts, headings, code…"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
      aria-label="Search"
      aria-controls="SearchResults"
      aria-autocomplete="list"
      role="combobox"
      aria-expanded="true"
    />
    <button class="search-close" type="button" aria-label="Close search" data-search-close>
      <kbd aria-hidden="true">Esc</kbd>
      <Icon name="x" size={18} />
    </button>
  </form>
  <div class="search-results" id="SearchResults" role="listbox" aria-label="Results"></div>
  <div class="search-foot">
    <span class="hint"><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
    <span class="hint"><kbd><Icon name="enter" size={11} /></kbd> Open</span>
    <span class="count" data-search-count></span>
  </div>
</dialog>
