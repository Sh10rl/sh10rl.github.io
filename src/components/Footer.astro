---
import { site } from '../site.config';
import Icon from './Icon.astro';
import bangumiMusume from '../assets/bangumi-musume.png?url';
import yamiboIcon from '../assets/yamibo.png?url';
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="footer-mark" href="/">{site.title}</a>
    <nav class="footer-links" aria-label="Elsewhere">
      <a class="glass-btn" href={site.author.github} aria-label="GitHub" title="GitHub" rel="me noopener" target="_blank"><Icon name="github" /></a>
      <a class="glass-btn" href={site.author.bangumi} aria-label="Bangumi" title="Bangumi" rel="me noopener" target="_blank"><span class="bangumi-mark" style={{ backgroundImage: `url(${bangumiMusume})` }} aria-hidden="true"></span></a>
      <a class="glass-btn" href={site.author.yamibo} aria-label="百合会 (Yamibo)" title="百合会 (Yamibo)" rel="me noopener" target="_blank"><span class="yamibo-mark" style={{ '--yamibo-icon': `url(${yamiboIcon})` }} aria-hidden="true"></span></a>
      <a class="glass-btn" href={`mailto:${site.author.email}`} aria-label="Email" title="Email"><Icon name="mail" /></a>
      <a class="glass-btn" href="/feed.xml" aria-label="RSS feed" title="RSS"><Icon name="rss" /></a>
    </nav>
  </div>
</footer>

<style>
  /* Official musume_2 frame: https://bgm.tv/img/rc3/bg_musume_2x.png */
  .bangumi-mark {
    /* Visible bounds are 74 × 94 px, starting at (160, 6) in the sprite. */
    width: 14.8px;
    height: 18.8px;
    background-repeat: no-repeat;
    background-size: 112px 30px;
    background-position: -32px -1.2px;
    filter: grayscale(1);
    opacity: 0.8;
    transition: opacity var(--t-hover);
  }

  .glass-btn:is(:hover, :focus-visible) .bangumi-mark {
    opacity: 1;
  }

  /* Original logo: https://www.yamibo.com/img/logo.png */
  .yamibo-mark {
    position: relative;
    width: 18px;
    height: 18px;
    overflow: hidden;
    border-radius: 50%;
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .yamibo-mark::after {
    content: '';
    position: absolute;
    inset: 1px;
    background: currentColor;
    -webkit-mask: var(--yamibo-icon) center / contain no-repeat;
    mask: var(--yamibo-icon) center / contain no-repeat;
  }
</style>
