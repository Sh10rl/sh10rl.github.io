---
import sketchEntries from '../assets/sketches/sketches.json';
import { getCategories, getPosts } from '../lib/posts';
import { site } from '../site.config';
import PostList from './PostList.astro';

interface Props {
  category?: string;
}

const { category = '' } = Astro.props;
// Every post is rendered on every index page; the ones outside the category are hidden.
// That lets the tabs filter in place (with the rows gliding) instead of loading a new page.
const posts = await getPosts();
const categories = await getCategories();
const tabs = [
  { key: '', label: 'All', count: posts.length, url: '/', title: site.title },
  ...categories.map((c) => ({ key: c.key, label: c.label, count: c.count, url: `/categories/${c.key}/`, title: `${c.label} · ${site.title}` })),
];
// One sketch is drawn behind the list, a different one on each load; src/scripts/sketch.ts picks it and fetches it.
const urls = import.meta.glob<string>('../assets/sketches/*.svg', { query: '?url', import: 'default', eager: true });
const sketches = Object.entries(sketchEntries).map(([name, { credit }]) => {
  const url = urls[`../assets/sketches/${name}.svg`];
  if (!url) throw new Error(`src/assets/sketches/${name}.svg is missing: run node scripts/generate-sketches.mjs`);
  return { name, url, credit };
});
---

<div class="page page-index">
  <section class="column index" aria-labelledby="IndexHeading">
    <header class="index-head">
      <h1 class="sr-only" id="IndexHeading">Writing</h1>
      <nav class="tabs" aria-label="Categories" data-tabs data-reveal style="--i: 0">
        {
          tabs.map((tab) => {
            const current = tab.key === category;
            return (
              <a href={tab.url} data-astro-prefetch="false" data-filter={tab.key} data-title={tab.title} aria-current={current ? 'page' : undefined}>
                {current && <span class="tab-chip" aria-hidden="true" />}
                <span class="tab-label">{tab.label}</span>
                <span class="tab-count">{tab.count}</span>
              </a>
            );
          })
        }
      </nav>
    </header>
    <PostList posts={posts} filter={category} revealFrom={1} />
    <div class="sketch-corner" data-sketch-corner hidden>
      <button class="sketch-hide" type="button" data-sketch-hide hidden>Hide artwork</button>
      {
        sketches.map(({ name, credit }) => (
          <p class="sketch-credit" data-sketch-credit={name} hidden>
            <span class="credit-line">
              © <span lang={credit.artist.lang}>{credit.artist.name}</span> <span class="credit-bar">|</span>{' '}
              <a href={credit.source.url} rel="noopener" target="_blank">{credit.source.name}</a>
            </span>
            {credit.lineArt && (
              <span class="credit-line">
                processed with <a href={credit.lineArt.url} rel="noopener" target="_blank">{credit.lineArt.name}</a>
              </span>
            )}
          </p>
        ))
      }
      <p class="sketch-note" data-sketch-note hidden>
        Artwork hidden <span class="credit-bar">|</span> <button type="button" data-sketch-show aria-label="Show artwork">Show</button>
      </p>
    </div>
  </section>
  <div class="sketch" aria-hidden="true" data-sketches={JSON.stringify(sketches.map(({ name, url }) => ({ name, url })))}></div>
</div>
